# Wasel Egypt frontend environment
# Base URL of the Laravel API (no trailing slash, includes /api/v1)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Map tile URL for MapLibre GL JS (default: keyless OpenStreetMap
# standard raster). Any {z}/{x}/{y} raster endpoint works — do NOT use
# Leaflet {r} tokens (MapLibre raster sources request them literally).
VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png