# Local dev — Laravel API served by `php artisan serve --port=8000` (see dev.mjs).
# The client falls back to relative `/api/v1` (proxied via next.config.ts rewrites),
# but an absolute URL avoids any ambiguity when testing from 127.0.0.1 vs localhost.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
